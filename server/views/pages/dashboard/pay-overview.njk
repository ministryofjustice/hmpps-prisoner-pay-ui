{% extends "layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = applicationName + " - Pay Overview" %}
{% set mainClasses = "govuk-body" %}
{% set backLinkHref = "../../" %}

{% set weekPay = (payType.dailyPayAmount * 5) | currencyFromPence %}
{% set payTypeDescription = payType.description | lower %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ payType.description }}</h1>
      {# Following line needs to be abstracted out when more pay types are added and API is used to get pay types #}
      <p class="govuk-body">People who have been signed off sick for more than 4 weeks.</p>
      <p class="govuk-body">
        They're paid {{ payTypeDescription }} pay of {{ payType.dailyPayAmount | currencyFromPence }} per day
        ({{ weekPay }} per week)
      </p>
      <p class="govuk-body"><a class="govuk-link--no-visited-state" href="../pay-rates">Change pay rates</a></p>

      {{
        govukButton({
            text: "Add someone to " + payTypeDescription,
            href: './register/new',
            attributes: {
                'data-qa': 'add-to-pay-type-button'
            }
        })
      }}

      {% set rows = [] %}
      {% for row in records %}
        {% set nameHTML %}
          <div {{ "class=" + options.classes if options.classes }} data-qa="prisoner-summary">
            <div data-qa="prisoner-name">
              <a class="govuk-link--no-visited-state" href="{{ digitalPrisonServiceUrl }}/prisoner/{{ row.prisonerNumber }}" target="_blank" rel="noopener noreferrer">{{ row | formatName(NameFormatStyle.firstLast, false) }}<span class="govuk-visually-hidden"> (opens in a new tab)</span></a>
            </div>
            <div class="govuk-body-s govuk-!-margin-0 secondary-text-colour" data-qa="prisoner-number">
              {{ row.prisonerNumber }}
            </div>
          </div>
        {% endset %}
        {% set changeLink %}
          <a class="govuk-link--no-visited-state" href="./remove/{{ row.id }}/removal-date">
            {%- if row.endDate -%}
              Change end date<span class="govuk-visually-hidden">
                for {{ row | formatName(NameFormatStyle.firstLast, false) }}</span
              >
            {%- else -%}
              Remove
              <span class="govuk-visually-hidden">{{ row | formatName(NameFormatStyle.firstLast, false) }} </span>from
              {{ payTypeDescription }}
            {%- endif -%}
          </a>
        {% endset %}
        {%
          set rows = (rows.push([
              {
                  html: nameHTML
              }, {
                  text: row.cellLocation
              }, {
                  text: row.startDate | formatDate('d MMMM yyyy')
              }, {
                  text: (row.endDate | formatDate('d MMMM yyyy')) if row.endDate else 'None set'
              }, {
                  text: ''
              }, {
                  html: changeLink
              }
          ]), rows)
        %}
      {% endfor %}
      {{
        govukTable({
            attributes: {
                'data-module': 'moj-sortable-table',
                'data-table-fixed-rows': 'true',
                'data-qa': 'pay-overview-table'
            },
            caption: "Preview",
            captionClasses: "govuk-visually-hidden",
            head: [
                {
                    text: "Prisoner Details",
                    attributes: { "aria-sort": "ascending" }
                },
                {
                    text: "Cell location",
                    attributes: { "aria-sort": "none" }
                },
                {
                    text: payType.description + " start date",
                    attributes: { "aria-sort": "none" }
                },
                {
                    text: "End Date",
                    attributes: { "aria-sort": "none" }
                },
                {
                    text: "Allocations",
                    attributes: { "aria-sort": "none" }
                },
                {
                    text: ""
                }
            ],
            rows: rows,
            classes: "pay-overview-table govuk-!-margin-bottom-6"
        })
      }}
    </div>
  </div>
{% endblock %}
