{% extends "layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "components/radios/macro.njk" import appRadios %}
{% set pageTitle = applicationName + " - Start date" %}
{% set mainClasses = "govuk-body" %}
{% set backLinkHref = "./add-prisoner-results?query=" + (searchQuery | urlencode) %}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ payType.description }}</span>
      <form method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        {{ appRadios(radios) }}
        <div class="govuk-button-group">
          {{ govukButton({ text: "Continue" }) }}
          <a class="govuk-link--no-visited-state" href="cancel">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
