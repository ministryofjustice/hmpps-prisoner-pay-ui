{% extends "layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageTitle = applicationName + " - " + pageTitleSuffix %}
{% set mainClasses = "govuk-body" %}
{% set backLinkHref = "./" + previousPage %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ payType.description }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {{ govukSummaryList(summaryList) }}

      <form method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <div class="govuk-button-group">
          {{
            govukButton({
                text: confirmButtonText
            })
          }}
          <a class="govuk-link--no-visited-state" href="cancel">{{ cancelLinkText }}</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
